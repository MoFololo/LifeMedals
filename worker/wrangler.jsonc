{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifemedals-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-terra",
    "GLOBAL_REQUESTS_PER_MINUTE": "20",
    "MONTHLY_REQUEST_BUDGET": "500"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GLOBAL_USAGE_GATE",
        "class_name": "GlobalUsageGate"
      }
    ]
  },
  "exports": {
    "GlobalUsageGate": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
