# LifeMedals - 环境变量说明
# 使用方法：cp .env.example .env，然后填入真实值
# ⚠️  .env 已在 .gitignore 中，绝对不要把真实值提交到 git

# ------------------------------------------------------------------
# Supabase（客户端 + Edge Functions 均需要）
# 在 Supabase Dashboard → Project Settings → API 中获取
# ------------------------------------------------------------------

# Project URL，格式：https://<project-id>.supabase.co
SUPABASE_URL=

# anon/public key（客户端可见，受 RLS 保护）
SUPABASE_ANON_KEY=

# service_role key（仅限服务端/Edge Functions，拥有绕过 RLS 的权限，绝对不要放进客户端代码）
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# OpenAI（仅用于 Supabase Edge Functions，禁止写入客户端代码）
# 在 https://platform.openai.com/api-keys 中获取
# 部署时通过 `supabase secrets set OPENAI_API_KEY=xxx` 写入 Edge Function 环境变量
# ------------------------------------------------------------------

OPENAI_API_KEY=

# ------------------------------------------------------------------
# 本地开发（可选，使用 Supabase CLI 本地模拟时填写）
# ------------------------------------------------------------------

# 本地 Supabase 实例 URL（supabase start 后默认为 http://localhost:54321）
# SUPABASE_LOCAL_URL=http://localhost:54321

# 本地 Supabase anon key（supabase start 输出中可找到）
# SUPABASE_LOCAL_ANON_KEY=

